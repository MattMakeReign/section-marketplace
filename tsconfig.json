{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@mr/section-library-ui": ["./lib/tools-ui/section-library/index.ts"],
      "@mr/section-library-ui/styles.css": ["./lib/tools-ui/section-library/styles.css"],
      "@mr/tools-ui": ["./lib/tools-ui/index.ts"],
      "@mr/tools-ui/styles.css": ["./lib/tools-ui/styles/index.css"],
      "@mr/tools-ui/section-library": ["./lib/tools-ui/section-library/index.ts"],
      "@mr/tools-ui/section-library/styles.css": ["./lib/tools-ui/section-library/styles.css"],
      "@mr/canonical-stack": ["./lib/canonical-stack/index.ts"],
      "@mr/canonical-stack/styles.css": ["./lib/canonical-stack/styles.css"]
    }
  },
  "include": ["scripts/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "components/**/*.tsx", "sections/**/*.tsx", "lib/**/*.ts", "lib/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
