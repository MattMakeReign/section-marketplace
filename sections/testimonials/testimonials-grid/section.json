{
  "id": "testimonials-grid",
  "name": "Testimonials — Grid",
  "category": "testimonials",
  "version": "1.0.0",
  "track": "stable",
  "lifecycle": "Archived",
  "description": "Three-up testimonial grid. Stacks single-column on mobile, three columns at md+. Each card carries quote, attribution, and role. Use when you want all testimonials visible at once rather than browsable.",
  "props": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  },
  "dependencies": [
    "@/components/section",
    "@/components/section-grid"
  ],
  "motionDensity": [
    "static",
    "low"
  ],
  "responsive": {
    "profile": "1 col mobile / 3 col desktop",
    "breakpoints": [
      "mobile",
      "tablet",
      "desktop"
    ],
    "notes": "Renders 1 column under md, 3 columns at md+. Card heights equalise via grid auto-rows."
  },
  "previews": {
    "static": "preview.svg"
  },
  "tags": [
    "editorial",
    "minimal",
    "social-proof"
  ],
