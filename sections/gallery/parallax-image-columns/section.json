      "type": "string",
      "default": "Scroll"
    },
    "caption": {
      "type": "string"
    },
    "columns": {
      "type": "array",
      "description": "Four columns of three images each. Caller-supplied columns replace defaults; missing columns fall back to seeded placeholders.",
