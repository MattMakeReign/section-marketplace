{
  "id": "features-flip-carousel",
  "name": "Features — Flip Carousel",
  "category": "features",
  "version": "0.0.1",
  "track": "experimental",
  "lifecycle": "Submitted",
  "description": "Horizontal scroll-snap carousel of feature cards that flip on hover. Front face shows an icon + short title; back face reveals body copy + a learn-more link. Arrow controls scroll one card at a time. Cards are responsive — one card with peek on mobile, ~1.5 on tablet, three across on desktop.",
  "props": {
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "icon": {
            "type": "node"
          },
          "link": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": [
    "@/components/section",
    "@/components/section-grid"
  ],
  "motionDensity": [
    "low",
    "medium"
  ],
  "responsive": {
    "profile": "horizontal-scroll-snap with breakpoint-aware card widths",
    "breakpoints": [
      "mobile",
      "tablet",
      "desktop"
    ],
    "notes": "Card widths step from 85vw (clamped at 22rem) on mobile, to ~56vw (clamped at 24rem) on tablet, to ~30vw (clamped at 22rem) on desktop. Scroll-snap is `mandatory` on mobile for confident swipes, `proximity` on tablet+ for a looser feel."
  },
